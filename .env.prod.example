# Переменные для docker-compose.prod.yml и Caddy (HTTPS-сертификаты).
# Скопируйте в .env рядом с docker-compose.prod.yml и заполните реальными значениями.

# Домен, на котором будет открываться сайт. Caddy сам выпустит сертификат на него
# и на поддомен storage.<домен> (хранилище файлов) — оба должны указывать на IP сервера в DNS.
DOMAIN=example.kz

# Email для Let's Encrypt (уведомления об истечении сертификата, не публикуется)
ACME_EMAIL=you@example.com

# Ключи доступа к MinIO (должны совпадать с S3_ACCESS_KEY / S3_SECRET_KEY в apps/api/.env)
S3_ACCESS_KEY=soyleup
S3_SECRET_KEY=change-me-to-a-random-string
