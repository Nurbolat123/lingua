NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://lingua:lingua@localhost:5432/lingua?schema=public
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
WEB_ORIGIN=http://localhost:3000
CONSENT_VERSION=2026-09-v1
SEED_ADMIN_EMAIL=admin@lingua.local
SEED_ADMIN_PASSWORD=change-me-min-12-chars

# S3/MinIO — публичный бакет для учебных материалов (аудио, картинки)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=lingua
S3_SECRET_KEY=lingua-minio
S3_BUCKET_CONTENT=content
S3_PUBLIC_URL_BASE=http://localhost:9000/content
